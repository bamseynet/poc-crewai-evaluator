# Copy to .env for local overrides. Never commit real credentials.

# fake (default, no AWS needed) or bedrock.
LLM_MODE=fake

# Bedrock cross-Region inference profile ids. Evaluator: judgement, the strongest model.
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5
# Researcher and drafter: high-volume writing, a cheaper model.
BEDROCK_WORKER_MODEL_ID=us.anthropic.claude-sonnet-5-5
AWS_REGION=us-east-1

# Delay between streamed words from the fake LLM, so the demo is watchable.
FAKE_LLM_DELAY_MS=0

# Optional. When set, the API requires this bearer token to start or watch a run.
# API_ACCESS_TOKEN=
